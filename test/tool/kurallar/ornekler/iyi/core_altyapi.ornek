// yol: lib/core/metin/turkce.dart
/// Türkçe küçük harf: İ → i, I → ı, ardından genel küçük harf.
String turkceKucukHarf(String s) =>
    s.replaceAll('İ', 'i').replaceAll('I', 'ı').toLowerCase();
