class Tayfa {
  const Tayfa(this.ad);

  factory Tayfa.fromJson(Map<String, Object?> json) =>
      Tayfa(json['ad']! as String);

  static Tayfa oku(Map<String, Object?> json) => Tayfa.fromJson(json);

  final String ad;

  Map<String, Object?> toJson() => {'ad': ad};

  Object? fromJson(Object? json) => json;
}
