import 'package:flutter/cupertino.dart';
import 'package:flutter/material.dart';

// Yorumdaki RefreshIndicator bulgu üretmez.
Widget liste(Future<void> Function() yenile) => RefreshIndicator(
  onRefresh: yenile,
  child: CustomScrollView(
    slivers: [CupertinoSliverRefreshControl(onRefresh: yenile)],
  ),
);
