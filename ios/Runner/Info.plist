<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Tayfam</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>tayfam</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.73439258394-bk26461t68cc7c2f7opa5ata0cv14h54</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Push (istemci ADR-0019 §1, iOS notu): otomatik FCM kaydı kapalı;
	     kayıt yalnızca oturum açık ve izin verilmişken yapılır (Android
	     manifestindeki firebase_messaging_auto_init_enabled=false). -->
	<key>FirebaseMessagingAutoInitEnabled</key>
	<false/>
	<!-- ADR-0021: fotoğraf seçici (PHPicker) izin istemez; metin yine de gerekli. Kamera yalnızca "Fotoğraf çek"e basınca sorulur. -->
	<!-- Kamera iki yerde kullanılır: fotoğraf çekme (ADR-0021) ve QR ile cihaz bağlama (ADR-0020). -->
	<!-- İhracat uyumu (ADR-0034, Kararlar 2026-11-27 §6): uygulama birebir
	     mesaj için standart algoritmalar taşır (libsignal); herkese açık,
	     ücretsiz bir tüketici uygulaması olarak ABD EAR kitlesel pazar
	     muafiyetine dayanır (Signal-iOS ile aynı beyan). `true` App Store
	     Connect'te onaylı belge ve ITSEncryptionExportComplianceCode ister.
	     Fransa beyansız satışa açılmaz. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Profil, kapak ya da av fotoğrafı çekmek ve başka bir cihazını bağlamak için QR kod okutmak üzere kamerana erişilir. QR okutulurken görüntü kaydedilmez; çektiğin fotoğrafın konum bilgisi gönderilmeden silinir.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Yüz yüze bir etkinlikte "Geldim" dediğinde buluşma noktasına yakın olduğunu doğrulamak için konumun yalnızca o an kullanılır; saklanmaz.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Profil, kapak ya da av fotoğrafı seçmek için yalnızca seçtiğin fotoğrafa erişilir. Fotoğrafın konum bilgisi gönderilmeden silinir.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
