<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- İnternet (CLAUDE.md, En az izin). flutter create bunu yalnızca
         debug/profile manifestine koyar; sürüm derlemesi de API'ye
         bağlanacağı için ana manifestte. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Varış bildirimi ("Geldim", ADR-0015 §5): yüz yüze etkinlikte
         buluşma noktasına 300 m kontrolü için tek seferlik konum. İzin
         yalnızca düğmeye basınca, "uygulamayı kullanırken" kapsamıyla
         istenir. Android 12+ hassas konumu yaklaşık konumla birlikte
         istemeyi zorunlu kılar; 300 m kontrolü yaklaşık konumla yapılamaz. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Kütüphanelerin manifest birleştirmesiyle gelebilecek arka plan
         konumu ve konum ön plan hizmeti izinleri engellenir (en az izin).
         Uygulama konum akışı ve arka plan konumu kullanmaz. -->
    <uses-permission
        android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_LOCATION"
        tools:node="remove"/>
    <!-- Biyometrik izinler bir kütüphanenin (AndroidX) manifestiyle
         geliyordu; uygulama biyometrik doğrulama kullanmaz (en az izin). -->
    <uses-permission
        android:name="android.permission.USE_BIOMETRIC"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        tools:node="remove"/>
    <!-- Yedekleme ve cihaz aktarımı tamamen kapalı (ADR-0005, ADR-0006,
         ADR-0010, #12): token'lar ve anahtarlar ne buluta ne yeni cihaza
         gider. allowBackup="false" bulut yedeğini kapatır, ama hedef SDK
         31+ uygulamada cihazdan cihaza aktarımı kapatmaz; bunu
         dataExtractionRules (API 31+) kapatır. fullBackupContent API 30 ve
         öncesi içindir. CI'daki manifest denetimi üçünü de doğrular. -->
    <application
        android:label="Tayfam"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Uygulama linkleri (Android App Links, ADR-0018 §6, kesin
                 kural 9): yalnızca https://tayfam.app ve yalnızca davet
                 (/davet#<token>) ile referans (/r/<KOD>) yolları. Alan adı
                 site/.well-known/assetlinks.json ile doğrulanır
                 (autoVerify); doğrulanmazsa Android linki tarayıcıda açar.
                 Adres yönlendiricide yeniden doğrulanır. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="tayfam.app"/>
                <data android:path="/davet"/>
                <data android:pathPrefix="/r/"/>
            </intent-filter>
            <!-- Gelen link Flutter'ın yönlendiricisine (go_router) verilir;
                 ek paket gerekmez. Varsayılan da açıktır; açıkça yazıldı. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true"/>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
