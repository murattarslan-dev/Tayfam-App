<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) yedekleme ve cihazdan cihaza aktarım kuralları
     (#12, ADR-0005, ADR-0006, ADR-0010). Hiçbir alan ne bulut yedeğine ne
     de cihazdan cihaza aktarıma girer: güvenli depodaki kayıtlar (token,
     ayarlar) Keystore anahtarı taşınmadığı için yeni cihazda zaten
     çözülemez; tutmadığın veri çalınamaz. allowBackup="false" yalnızca
     bulut yedeğini kapatır, cihaz aktarımını kapatmaz; bu yüzden ikisi de
     burada açıkça hariç tutulur. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
        <exclude domain="device_root" path="."/>
        <exclude domain="device_file" path="."/>
        <exclude domain="device_database" path="."/>
        <exclude domain="device_sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
        <exclude domain="device_root" path="."/>
        <exclude domain="device_file" path="."/>
        <exclude domain="device_database" path="."/>
        <exclude domain="device_sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
